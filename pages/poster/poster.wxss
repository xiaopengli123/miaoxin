.poster-wrap {
  padding: 40rpx 0;
  text-align: center;
}
.poster-canvas {
  width: 375px;
  height: 500px;
  margin: 0 auto;
}
.poster-tip {
  color: #8A8A8F;
  font-size: 24rpx;
  margin: 30rpx 40rpx;
  line-height: 1.6;
}
.save-btn {
  margin: 0 60rpx;
  background: #FFD666;
  color: #1A1A1F;
  border-radius: 48rpx;
  text-align: center;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 700;
}
