.form {
  padding: 24rpx;
}
.field {
  background: #1A1A1F;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.field-label {
  font-size: 26rpx;
  color: #8A8A8F;
  margin-bottom: 16rpx;
}
.field-input {
  background: #0F0F12;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  color: #F5F5F7;
  font-weight: 600;
}
.field-control {
  display: flex;
}
.radio {
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #F5F5F7;
}

.save-btn {
  background: #FFD666;
  color: #1A1A1F;
  border-radius: 48rpx;
  text-align: center;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 12rpx;
}
.form-tip {
  margin-top: 24rpx;
  color: #5A5A5F;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.6;
}

.section-title {
  margin: 32rpx 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #F5F5F7;
}
.rate-card {
  background: #1A1A1F;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
}
.rate-stars {
  font-size: 56rpx;
  letter-spacing: 12rpx;
}
.star {
  color: #3A3A40;
}
.star.on {
  color: #FFD666;
}
.rate-text {
  color: #C0A050;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.feedback-card {
  margin-top: 20rpx;
  background: #1A1A1F;
  border-radius: 20rpx;
  padding: 28rpx;
}
.feedback-label {
  color: #8A8A8F;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.feedback-input {
  background: #0F0F12;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #F5F5F7;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}
.feedback-btn {
  background: #FFD666;
  color: #1A1A1F;
  border-radius: 40rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 16rpx;
}
.feedback-hint {
  color: #5A5A5F;
  font-size: 22rpx;
  margin-top: 16rpx;
  line-height: 1.6;
  text-align: center;
}
